# CORS_ORIGINS: Comma-separated list of allowed frontend origins
# Example: http://localhost:5173,https://myapp.com
CORS_ORIGINS=*

# LOG_LEVEL: uvicorn log level (debug, info, warning, error)
LOG_LEVEL=info

# Optional: Restrict to specific providers only (comma-separated)
# Leave empty to allow all providers
# ALLOWED_PROVIDERS=openai,anthropic,groq
