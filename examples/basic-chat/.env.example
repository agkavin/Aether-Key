# If you deploy the frontend (UI) independently of the backend (Proxy), 
# you MUST set this variable to your live proxy URL during the build step.
# For example: 
# VITE_PROXY_URL=https://proxy.yourdomain.com
#
# If left blank, it defaults to http://localhost:8000 in development,
# and dynamically defaults to the current browser origin (window.location.origin) in production.
VITE_PROXY_URL=

# Change this if your users run Ollama on a different network port/host
VITE_OLLAMA_URL=http://127.0.0.1:11434